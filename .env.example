# GROQ_API_KEY: Clé API requise pour les appels aux modèles Groq.
# Vous pouvez obtenir votre clé d'API sur https://console.groq.com
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WAITLIST_ADMIN_KEY: Clé secrète pour exporter la liste des emails early access via /api/waitlist/export?key=admin_secret_key
WAITLIST_ADMIN_KEY="admin_secret_key"
